
main: kit: feature: station: {

  name: key()
  title: "Station control surface binding for outbound integrations"
  version: '0.0.1'
  active: true
  base: 'BASE'

  transport: 'wrap'

  config: {
    options: {
      active: false
      url: ''
      fromEnv: true
      profile: ''
      secret: ''
      instance: ''
      register: true
      capture: 'meta'
    }
  }

  hook: {
    PostConstruct: active: true

    PrePoint: active: true
    PreDone: active: true
    PreUnexpected: active: true
  }

  # One dep per target: the station library only; sekreto is the
  # library's own dependency, never named here (design station.md 9.2).
  # perl/lua/c/cpp vendor the library through the tm overlay (no dep).
  deps: ts: {
    '@voxgig/station': { active: true, version: '>=0.0.1', kind: peer }
  }
  deps: js: {
    '@voxgig/station-js': { active: true, version: '>=0.0.1', kind: peer }
  }

  deps: go: {
    'github.com/voxgig/station/go': { active: true, version: 'v0.0.1', kind: prod }
  }

  deps: py: {
    'voxgig-station': { active: true, version: '0.0.1', kind: prod }
  }
  deps: rb: {
    'voxgig_station': { active: true, version: '0.0.1', kind: prod }
  }
  deps: php: {
    'voxgig/station': { active: true, version: '0.0.1', kind: prod }
  }

  deps: java: {
    'com.voxgig:station': { active: true, version: '0.0.1', kind: prod }
  }
  deps: kotlin: .java

  deps: csharp: {
    'Voxgig.Station': { active: true, version: '0.0.1', kind: prod }
  }

  deps: dart: {
    'voxgig_station': { active: true, version: '>=0.0.1', kind: prod }
  }
  deps: elixir: {
    'voxgig_station': { active: true, version: '>=0.0.1', kind: prod }
  }
  deps: rust: {
    'voxgig_station': { active: true, version: '>=0.0.1', kind: prod }
  }

  # SwiftPM needs a package URL as well as a product: the entry KEY is
  # the PRODUCT name (the module the adapter imports); the extra `url`
  # field is the git repository SwiftPM resolves; `version` feeds
  # `from:`. Package_swift.ts documents the convention.
  deps: swift: {
    'VoxgigStation': { active: true, version: '0.0.1', kind: prod, url: 'https://github.com/voxgig/station-swift' }
  }
}
