   "profile": {
    "set": [
     {
      "doc": true,
      "id": "profile#replace-wholesale",
      "in": {
       "config": {
        "profiles": {
         "default": {
          "plugin": {
           "solardemo": {
            "base": "http://dev:1",
            "resolve": "library"
